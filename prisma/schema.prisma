generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Portfolio {
  id            String              @id @default(cuid())
  name          String
  familyGroup   String?
  broker        String?
  description   String?
  isDefault     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  analyses      AIAnalysis[]
  holdings      Holding[]
  importHistory ImportHistory[]
  snapshots     PortfolioSnapshot[]
  transactions  Transaction[]
  watchlists    Watchlist[]
}

model Holding {
  id           String        @id @default(cuid())
  portfolioId  String?
  symbol       String
  name         String
  shares       Float
  avgCost      Float
  sector       String?
  notes        String?
  exchange     String        @default("NSE")
  purchaseDate String?
  broker       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  portfolio    Portfolio?    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id          String    @id @default(cuid())
  portfolioId String
  holdingId   String?
  symbol      String
  name        String
  type        String
  shares      Float
  price       Float
  amount      Float
  brokerage   Float?
  date        String
  exchange    String    @default("NSE")
  notes       String?
  importId    String?
  createdAt   DateTime  @default(now())
  holding     Holding?  @relation(fields: [holdingId], references: [id])
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id          String          @id @default(cuid())
  portfolioId String?
  name        String
  createdAt   DateTime        @default(now())
  portfolio   Portfolio?      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  items       WatchlistItem[]
}

model WatchlistItem {
  id          String    @id @default(cuid())
  symbol      String
  name        String
  watchlistId String
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([symbol, watchlistId])
}

model AIAnalysis {
  id              String     @id @default(cuid())
  portfolioId     String?
  symbol          String
  timeframe       String     @default("DAILY")
  signal          String
  confidence      Float
  investmentScore Float
  risks           String
  bullishFactors  String
  bearishFactors  String
  entryZone       String
  stopLoss        Float
  targetPrice     Float
  summary         String
  rawMetrics      String
  reasoning       String?
  createdAt       DateTime   @default(now())
  portfolio       Portfolio? @relation(fields: [portfolioId], references: [id])
}

model ImportHistory {
  id          String    @id @default(cuid())
  portfolioId String
  broker      String
  fileType    String
  fileName    String
  rowCount    Int
  status      String    @default("SUCCESS")
  notes       String?
  importedAt  DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model PortfolioSnapshot {
  id          String    @id @default(cuid())
  portfolioId String
  date        String
  totalValue  Float
  totalCost   Float
  healthScore Float
  data        String
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, date])
}

model PriceCache {
  id        String   @id @default(cuid())
  symbol    String   @unique
  data      String
  updatedAt DateTime @updatedAt
}
